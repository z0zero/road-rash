{
  // Type-checks the Race module without DOM or Node types, so any browser or
  // Node API used inside it is a type error (ADR 0004, CODING_STANDARDS.md).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/race/**/*.ts"],
  "exclude": ["src/race/**/*.test.ts"]
}
